%%
% This is a template for generating nice PDF docs from Markdown in pandoc
% It is oriignally based on the Eisvogel pandoc LaTeX template.
%
% Information on the original Eisvogel template is available on its GitHub page:
% https://github.com/Wandmalfarbe/pandoc-latex-template
%%

%%
%% Options for packages loaded elsewhere
%%
\PassOptionsToPackage{unicode$for(hyperrefoptions)$,$hyperrefoptions$$endfor$}{hyperref}
\PassOptionsToPackage{hyphens}{url}
\PassOptionsToPackage{dvipsnames,svgnames,x11names,table}{xcolor}
$if(CJKmainfont)$
\PassOptionsToPackage{space}{xeCJK}
$endif$
\let\nofiles\relax
\documentclass[
  $for(babel-otherlangs)$
  $babel-otherlangs$,
  $endfor$
  $if(babel-lang)$
  $babel-lang$,
  $endif$
  $if(fontsize)$
  $fontsize$,
  $else$
  10pt,
  $endif$
  $if(papersize)$
  $papersize$paper,
  $else$
  paper=letter,
  $endif$
  $for(classoption)$
  $classoption$$sep$$if(classoption)$,$endif$
  $endfor$
captions=tableheading]{$if(book)$scrbook$else$scrartcl$endif$}
$if(beamerarticle)$
\usepackage{beamerarticle} % needs to be loaded first
$endif$
\usepackage{xcolor}
\usepackage{stackengine}
\usepackage[calc,showdow,english]{datetime2}
$if(geometry)$
\usepackage[$for(geometry)$$geometry$$sep$,$endfor$]{geometry}
$else$
\usepackage[margin=1in,includehead=true,includefoot=true,centering]{geometry}
$endif$
\usepackage{amsmath,amssymb}
$if(titlepage-logo)$
\usepackage[export]{adjustbox}
\usepackage{graphicx}
$endif$

\usepackage{underscore}[strings,nohyphen]

\usepackage{fancyvrb}
\usepackage{fvextra}
\fvset{breaklines}

%%
%% Date and Time Styles
%%
\DTMnewdatestyle{longDateFormat}{%
  \renewcommand{\DTMdisplaydate}[4]{%
    \DTMmonthname{##2}\nobreakspace%  (full) Month
    \number##3,\space%                day,
    \number##1%                       year
  }%
  \renewcommand{\DTMDisplaydate}{\DTMdisplaydate}%
}

%%
%% Fonts
%%
\usepackage{fontspec}
\usepackage{microtype}

\setmonofont{Fira Code Light}[
  BoldFont={Fira Code Regular},
  Weight=300,
  Contextuals=Alternate, % Activate the calt feature
  Scale=MatchLowercase
]

\newfontface{\inlinecodefont}{Fira Code Light}[
  BoldFont={Fira Code Regular},
  Weight=300,
  Contextuals=Alternate,
  Scale=0.85
]

\makeatletter
$if(debug)$
% Debug mode annotates each inline-code span with the surrounding text size and
% the effective inline-code size so the dedicated PDF test target can expose
% LaTeX's current font-state decisions without changing normal guide output.
\DeclareRobustCommand{\inlinecode}[1]{%
  \begingroup
  \edef\inlinecodeoutersize{\f@size}%
  {\inlinecodefont
    \xdef\inlinecodeinnersize{\f@size}%
    #1%
  }%
  {\leavevmode\textcolor{gray}{\scriptsize[out=\inlinecodeoutersize{}pt in=\inlinecodeinnersize{}pt]}}%
  \endgroup
}
$else$
\DeclareRobustCommand{\inlinecode}[1]{{\inlinecodefont #1}}
$endif$
\makeatother

\usepackage[light]{inter}
\usepackage[rm,rmtabular,light]{merriweather}

