%%
%% Lists
%%
\usepackage{enumitem}
\setlistdepth{20}
\setlist[itemize]{label=\sffamily\small\textbullet}
\setlist[itemize,1]{label=\sffamily\small\textbullet}
\setlist[itemize,2]{label=\sffamily\small\textbullet}
\setlist[itemize,3]{label=\sffamily\small\textbullet}
\setlist[itemize,4]{label=\sffamily\small\textbullet}
\setlist[itemize,5]{label=\sffamily\small\textbullet}
\setlist[itemize,6]{label=\sffamily\small\textbullet}

%%
%% Headings
%%
\newfontface{\sectionfont}{Inter}[Weight=300]%
\newfontface{\subsectionfont}{Inter}[Weight=300]%
\newfontface{\subsubsectionfont}{Inter}[Weight=300]%
\newfontface{\paragraphfont}{Inter}[Weight=300]%
\newfontface{\subparagraphfont}{Inter}[Weight=300]%

\addtokomafont{section}{\sectionfont\Huge}
\addtokomafont{subsection}{\subsectionfont\huge}
\addtokomafont{subsubsection}{\subsubsectionfont\LARGE}
\addtokomafont{paragraph}{\paragraphfont\Large}
\addtokomafont{subparagraph}{\subparagraphfont\large}

