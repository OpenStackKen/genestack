\begin{document}

$if(created)$
\DTMsavedate{docDate}{$created$}
$else$
\DTMsavenow{docDate}
$endif$

\newfontface{\theTitleFont}{Inter}[Scale=2.5]
\newfontface{\theSubtitleFont}{Inter ExtraLight}[Weight=100,Scale=1.75]
\newfontface{\theAuthorFont}{Inter}[Scale=1.5,Weight=300]
\newfontface{\theTopicFont}{Inter}[Scale=1.5,Weight=300]
\newfontface{\theReleaseFont}{Fira Code Light}[Scale=1.15,Weight=300]
\newfontface{\theDateFont}{Inter}[Scale=1.25,Weight=300]
