$if(endnotes)$
$--
$-- Begin endnotes
$--
%%
% Endnotes
%%
\newpage
\begingroup
\parindent 1em
\parskip 0.5em

\DeclareInstance{enotez-list}{obsidian}{paragraph}
{
  heading=
  \section*{#1},
  notes-sep=0.25em,
  format=\scriptsize\sffamily\raggedright\leftskip1.5em,
  number=\makebox[0pt][r]{#1.\ }\ignorespaces,
}
\pdfbookmark{Endnotes}{Endnotes}
\printendnotes[obsidian]
\endgroup
$--
$-- End endnotes
$--
$endif$

