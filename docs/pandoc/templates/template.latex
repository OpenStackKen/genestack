%%
%% Footnote Customizations
%%

$if(endnotes)$
$--
$-- Use endnotes instead
$--
%%
% Change footnotes to endnotes
%%
\usepackage[hang,flushmargin,ragged,bottom,multiple]{footmisc}
\usepackage{footnotebackref}
\usepackage{enotez}
\setenotez{
  backref = true,
  list-name = $if(endnotes-section)$$endnotes-section$$else$References$endif$
}
\usepackage{hyperref}
\let\footnote=\endnote
$else$
$--
$-- Set up footnotes
$--
%%
% Set up footnotes
%%
\usepackage{footnotehyper}
% We use explicit `\@makefntext` formatting below; disable footnotehyper's
% attempt to parse that macro for environment-form footnote support.
\footnotehyperparsefalse
\usepackage[hang,flushmargin,bottom,belowfloats,multiple,norule]{footmisc}
\interfootnotelinepenalty=10000 % keep a single footnote body from splitting across pages
\setlength{\footnotemargin}{0.75em} % set space between footnote nr and text
\setlength{\footnotesep}{0.6\baselineskip} % tighten stacked footnotes to avoid orphaned marks
\setlength{\skip\footins}{1em} % reduce the gap above the footnote block
\makeatletter
\long\def\@makefntext#1{\noindent{\footnotesize\sffamily\hb@xt@1.6em{\hss\@makefnmark\kern0.3em}#1}}
\makeatother
$endif$

%%
%% END Footnote Customizations
%%
$--
$-- End footnote customizations
$--

