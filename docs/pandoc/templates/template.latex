$--
$-- Titlepage
$--
$if(titlepage)$

%%
%% Titlepage
%%

\begin{titlepage}

  \afterpage{\restoregeometry}
  \newgeometry{left=1in, right=1in,top=1in, bottom=-0.15in}
  \definecolor{myColor}{HTML}{ffffff}
  \pagecolor{myColor}\afterpage{\nopagecolor}

  \thispagestyle{empty}
  \begin{flushright}
    \vspace{1em}
    $if(titlepage-logo)$
    \includegraphics[width=$if(logo-width)$$logo-width$$else$3.5in$endif$, right]{$titlepage-logo$}\\[4em]
    $endif$
    \theTitleFont{$title$}\\[1em]
    $if(subtitle)$
    \theSubtitleFont{$subtitle$}\\[1em]
    $endif$
    \theReleaseFont{$version$}\\[0.5em]
    \theDateFont\DTMUsedate{docDate}
  \end{flushright}
  \vfill
  \begin{center}
    \begin{tikzpicture}
      \node[scope fading=north, inner sep=0pt, outer sep=0pt]{
        \makebox[\textwidth]{\includegraphics[width=\paperwidth]{cloud-anywhere.png}}
      };
    \end{tikzpicture}
  \end{center}
\end{titlepage}
% for additional pages after the title, uncomment the following line first:
\clearpage
\restoregeometry
$endif$

$if(has-frontmatter)$
\frontmatter
$endif$
