$if(fonttest)$
%%
% Font Test
%%
\subsubsection{Font Test}\label{built-in-font-test}
Roman:\linebreak
\vspace{0.5em}
\hfill\textrm{\showfont}\par
\vspace{1em}

Sans Serif:\linebreak
\vspace{0.5em}
\hfill\textsf{\showfont}\par
\vspace{1em}

Monospace:\linebreak
\vspace{0.5em}
\hfill\texttt{\showfont}\par
\vspace{2em}
