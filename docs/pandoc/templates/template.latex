%%
%% Callouts
%%
\usepackage{tcolorbox}
\tcbuselibrary{all}
\usepackage{fontawesome5}

%%
% Define Base Box
%%
\tcbset{
  boxsettings/.style={
    boxrule=1pt, rounded corners=all, arc=2pt,
    left=5pt, right=5pt, top=5pt, bottom=5pt,
    boxsep=5pt, before skip=20pt, after skip=20pt,
    breakable, before upper={\ignorespaces},
    fonttitle=\small\intermedium,
    fontupper=\footnotesize\interlight,
    fontlower=\scriptsize\interlight,
  }
}

%%
% Note
%%
\definecolor{note-title}{HTML}{0d6ddd}
\definecolor{note-content}{HTML}{e9f0fc}
\definecolor{note-text}{HTML}{0d194a}
\definecolor{note-border}{HTML}{0d6ddd}

\newcommand\noteIcon{\faPencil*\hspace{0.5em}}
\newcommand\noteTitle{\noteIcon Note}

\NewTColorBox{note-box}{ O\noteTitle }{
  colframe=note-border, colback=note-content,
  coltitle=note-content,
  coltext=note-text, title={\noteTitle}, boxsettings,
}

