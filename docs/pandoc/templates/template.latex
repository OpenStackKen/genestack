%%
%% Tables
%%
\usepackage{tabularray}
\usepackage{tblr-extras}
\UseTblrLibrary{booktabs}
\UseTblrLibrary{caption}
\usepackage[singlelinecheck=off,justification=centering]{caption}

\DefTblrTemplate{caption-tag}{default}{}
\DefTblrTemplate{caption-sep}{default}{}
\DefTblrTemplate{contfoot-text}{default}{\centering\textit{(Continued on next page)}}
\DefTblrTemplate{conthead-text}{default}{\centering\textit{(Continued from previous page)}}

\NewTblrTheme{obsidian}{
  %%
  % Remove "Table #:" from captions
  %%
  \DefTblrTemplate{caption-tag}{obsidian}{}
  \DefTblrTemplate{contcaption-tag}{obsidian}{}
  \DefTblrTemplate{caption-sep}{obsidian}{}
  \DefTblrTemplate{contcaption-sep}{obsidian}{}
  \DefTblrTemplate{contfoot-text}{obsidian}{(Continued on next page)}
}

\SetTblrTemplate{conthead}{empty}
\SetTblrStyle{contfoot}{halign=c}

\SetTblrStyle{caption-tag}{font=\footnotesize\interlight\itshape}
\SetTblrStyle{contfoot-text}{font=\footnotesize\interlight\itshape}
\SetTblrStyle{conthead-text}{font=\footnotesize\interlight\itshape}

